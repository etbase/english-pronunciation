// Firestore 安全規則範本。請在 Firebase Console 自行發布，這份檔案不會自動部署。
//
// 這次會員第一階段只需要：已登入者讀自己的 users/{uid}。
// plan 只能由 Firebase Console（或之後的後端）修改，前端不能寫入。

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
